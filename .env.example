# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.
# Every value here mirrors a default in hybridsearch/config.py; uncomment to override.

# ── Storage ────────────────────────────────────────────────────────────────
# "local" writes JPEGs+sidecars to a directory; "s3" uploads to an S3 bucket.
HS_STORAGE_BACKEND=local

# For local: a URL the FE/BE serves the images dir from.
# For s3:    the bucket's public/CDN URL (must match the bucket+region below).
HS_STORAGE_BASE_URL=http://localhost:8000/images

# ── S3 (only used when HS_STORAGE_BACKEND=s3) ────────────────────────────────
HS_S3_BUCKET=
HS_S3_REGION=ap-northeast-2
# Object key prefixes: images under one, metadata sidecars under another.
HS_S3_IMAGE_PREFIX=images
HS_S3_META_PREFIX=meta
# AWS credentials are NOT set here — boto3 resolves them from the standard chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env, ~/.aws/credentials, or IAM role).

# ── Data paths / dataset ─────────────────────────────────────────────────────
# HS_DATA_DIR=data
# HS_IMAGES_DIR=data/images
# HS_MANIFEST_PATH=data/manifest.jsonl
# HS_DATASET_NAME=lmms-lab/flickr30k
# HS_DATASET_SPLIT=test
# HS_DEFAULT_LIMIT=10000

# ── OpenSearch ───────────────────────────────────────────────────────────────
# OPENSEARCH_AUTH picks how get_client() connects:
#   local -> dockerized OpenSearch, http, security off (dev default)
#   basic -> AWS Managed over HTTPS with FGAC master user (id/pw)
#   iam   -> AWS Managed over HTTPS with AWS SigV4 signing (no password)
OPENSEARCH_AUTH=local

# Local docker (dev) — security disabled:
# OPENSEARCH_HOST=localhost
# OPENSEARCH_PORT=9200
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=admin
# OPENSEARCH_USE_SSL=false

# AWS Managed OpenSearch (basic) — uncomment & fill. NOTE: port is 443, not 9200.
# OPENSEARCH_AUTH=basic
# OPENSEARCH_HOST=search-xxxxx.ap-northeast-2.es.amazonaws.com
# OPENSEARCH_PORT=443
# OPENSEARCH_USER=<master-user>
# OPENSEARCH_PASSWORD=<master-password>

# AWS Managed OpenSearch (iam) — sign with ambient AWS creds (EC2 role / env / ~/.aws):
# OPENSEARCH_AUTH=iam
# OPENSEARCH_HOST=search-xxxxx.ap-northeast-2.es.amazonaws.com
# AWS_REGION=ap-northeast-2
# OPENSEARCH_AWS_SERVICE=es        # "aoss" for OpenSearch Serverless

# HS_INDEX_NAME=images
# HS_SEARCH_PIPELINE=hybrid-pipeline

# ── Embedding ────────────────────────────────────────────────────────────────
# HS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HS_EMBEDDING_DIM=384
